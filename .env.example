# Cosgral Hub — lokalnie
#
# WAŻNE: przy COSGRAL_DB_MODE=local Supabase jest WYŁĄCZONY
# (puste dane albo folder /data). Produkcja CRM jest na Netlify Blobs
# albo na Supabase — uzupełnij klucze poniżej i usuń linię MODE=local.
COSGRAL_DB_MODE=local
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# ——— Supabase (prawdziwy stan CRM) ———
# Project: https://supabase.com/dashboard/project/bduwbnnvhahtcjjxaazv
# NEXT_PUBLIC_SUPABASE_URL=https://bduwbnnvhahtcjjxaazv.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Potem: usuń COSGRAL_DB_MODE=local i zrestartuj npm run dev

# Publiczny URL do linków w powiadomieniach na telefon
# (na produkcji: https://twoj-hub.netlify.app)
# COSGRAL_NOTIFY_BASE_URL=https://twoj-hub.netlify.app

# ——— WhatsApp (Green API) — grupa powiadomień ———
# WHATSAPP_GREEN_ID_INSTANCE=
# WHATSAPP_GREEN_API_TOKEN=
# WHATSAPP_CHAT_ID=120363XXXXXXXXX@g.us
# WHATSAPP_GREEN_API_URL=https://api.green-api.com

# Telegram (opcjonalnie, równolegle)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ——— Email → kontakt@cosgral.pl ———
NOTIFY_EMAIL_TO=kontakt@cosgral.pl
NOTIFY_EMAIL_FROM=Cosgral Hub <kontakt@cosgral.pl>
# SMTP_HOST=smtp.seohost.pl
# SMTP_PORT=587
# SMTP_USER=kontakt@cosgral.pl
# SMTP_PASS=
# albo: RESEND_API_KEY=re_...

# ——— Web Push (iPhone / PWA) ———
# Wygeneruj: npx web-push generate-vapid-keys
# Publiczny klucz MUSI być NEXT_PUBLIC_ (widoczny w przeglądarce)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:kontakt@cosgral.pl

# ——— Cosgral AI (Hub chat) ———
# Ten sam klucz co na Netlify — Gemini 2.0 Flash
# GEMINI_API_KEY=
